SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Use PostgreSQL in production. Leave unset to use the local SQLite DB_PATH.
DATABASE_URL=
DB_PATH=beacons.db

SAMOA_OFFSET_HOURS=13
TTL_SECONDS=900
FMC_OFFLINE_ALERT_AFTER_SECONDS=600
FMC_OFFLINE_ALERT_CHECK_SECONDS=60

# Configure the same value in the Flespi webhook's X-Webhook-Secret header.
FLESPI_WEBHOOK_SECRET=replace-with-a-long-random-value

MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SENDGRID_API_KEY=

N8N_WHATSAPP_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT=20

REPORTS_DIR=reports
ACTIVITY_REPORTS_DIR=activity_reports
AUDIT_REPORTS_DIR=audit_reports
